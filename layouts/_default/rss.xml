{{- /* The home feed carries the stream: notes and essays only.
       Hugo's built-in RSS would also list About and Contact as untitled items.
       Section feeds (/notes/, /essays/) carry their own pages. */ -}}
{{- $pages := .RegularPages -}}
{{- if .IsHome -}}
  {{- $pages = where .Site.RegularPages "Type" "in" (slice "notes" "essays") -}}
{{- end -}}
{{- $pages = $pages.ByDate.Reverse -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ if .IsHome }}{{ .Site.Title }}{{ else }}{{ .Title }} · {{ .Site.Title }}{{ end }}</title>
    <link>{{ .Permalink }}</link>
    <description>{{ .Site.Params.description }}</description>
    <generator>Hugo</generator>
    <language>en-us</language>
    {{- range first 1 $pages }}
    <lastBuildDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</lastBuildDate>
    {{- end }}
    <atom:link href="{{ .Permalink }}index.xml" rel="self" type="application/rss+xml" />
    {{- range $pages }}
    <item>
      {{- /* Notes are untitled by design; fall back to the timestamp, which
             carries the time when one was given -- the same string the site
             shows -- so several notes on one day stay distinguishable in a
             reader. In the else branch of `with`, dot is still the page. */}}
      <title>{{ with .Title }}{{ . }}{{ else }}{{ partial "timestamp.html" . }}{{ end }}</title>
      <link>{{ .Permalink }}</link>
      <pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" | safeHTML }}</pubDate>
      <guid>{{ .Permalink }}</guid>
      <description>{{ or .Params.summary .Content | transform.XMLEscape | safeHTML }}</description>
    </item>
    {{- end }}
  </channel>
</rss>
